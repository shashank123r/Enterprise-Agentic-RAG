# ──────────────────────────────────────────────
# Enterprise Agentic RAG Platform — Environment
# ──────────────────────────────────────────────

# ── General ──────────────────────────────────
PROJECT_NAME="Enterprise RAG Platform"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-with--python-c--import-secrets-print-secrets.token_hex-32--
API_V1_PREFIX=/api/v1

# ── Authentication ────────────────────────────
JWT_SECRET_KEY=generate-with--python-c--import-secrets-print-secrets.token_hex-32--
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=enterprise-rag
JWT_AUDIENCE=enterprise-rag-api

# ── PostgreSQL ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=enterprise_rag
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
POSTGRES_ECHO=false

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_SOCKET_TIMEOUT=5

# ── Milvus ────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ALIAS=default
MILVUS_COLLECTION_PREFIX=rag_

# ── NVIDIA NIM (Hosted API) ─────────────────────
# Endpoints point to NVIDIA's hosted API (integrate.api.nvidia.com).
# No local NVIDIA NIM Docker containers required.
NIM_EMBEDDING_URL=https://integrate.api.nvidia.com/v1
NIM_RERANKING_URL=https://integrate.api.nvidia.com/v1/rerank
NIM_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NIM_API_KEY=your-nvidia-nim-api-key-here
NIM_MODEL_EMBEDDING=nvidia/nv-embed-v1
NIM_MODEL_RERANK=nvidia/nv-rerank-qa-4
NIM_MODEL_CHAT=meta/llama-3.1-70b-instruct
NIM_TIMEOUT=60

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/rag-platform.log

# ── File Uploads ──────────────────────────────
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads

# ── Evaluation ────────────────────────────────
EVALUATION_ENABLED=true
GOLDEN_DATASET_PATH=./data/golden_dataset.json

# ── Monitoring ────────────────────────────────
OTEL_SERVICE_NAME=enterprise-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
